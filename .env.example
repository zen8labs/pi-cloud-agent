# Copy to .env and fill in. Never commit .env.
# One file at the repo root configures the controller; the web app reads only
# NEXT_PUBLIC_API_BASE.

# ── controller ───────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info

# Postgres. `pnpm up` starts one on 5532.
DATABASE_URL=postgres://pi_cloud_agent:pi_cloud_agent@localhost:5532/pi_cloud_agent

# The URL the sandbox dials back on. Must be reachable *from the sandbox*, so
# for a hosted sandbox provider this is a public tunnel, not localhost.
CONTROL_PLANE_URL=http://localhost:8080

# ── model ────────────────────────────────────────────────────────────────────
# provider/model. The provider segment names an OpenAI-compatible gateway.
AGENT_MODEL=aigateway/MiniMax/MiniMax-M2.7
AIGATEWAY_BASE_URL=
AIGATEWAY_API_KEY=

# ── sandbox ──────────────────────────────────────────────────────────────────
# Which SandboxProvider to use. See docs/adding-a-sandbox-provider.md.
SANDBOX_PROVIDER=e2b
SANDBOX_TIMEOUT_SECONDS=3900
RUN_WALL_CLOCK_SECONDS=3600

E2B_API_KEY=
E2B_TEMPLATE=pi-cloud-agent

# ── VCS ──────────────────────────────────────────────────────────────────────
# GitHub App is preferred (short-lived, repo-scoped tokens). A PAT also works.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=

BITBUCKET_TOKEN=
BITBUCKET_WEBHOOK_SECRET=

# ── web dashboard ────────────────────────────────────────────────────────────
# Comma-separated "owner/name" list offered in the repo selector. Empty means
# "ask the VCS provider what it can reach".
WEB_REPOS=
WEB_CORS_ORIGINS=*
