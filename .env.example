# Copy to .env and fill in. Never commit .env.
# One file at the repo root configures the controller; the web app reads only NEXT_PUBLIC_API_BASE.

# ── controller ───────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info

# Postgres. `pnpm up` starts one on 5532.
DATABASE_URL=postgres://pi_cloud_agent:pi_cloud_agent@localhost:5532/pi_cloud_agent

# The URL the sandbox dials back on. With local microSandbox, the host is
# reachable as host.microsandbox.internal. For E2B, use the public ngrok URL.
CONTROL_PLANE_URL=http://host.microsandbox.internal:8080

# ── sandbox ──────────────────────────────────────────────────────────────────
# Which SandboxProvider to use. microSandbox is the local default; set this to
# e2b when using hosted E2B instead. See docs/adding-a-sandbox-provider.md.
SANDBOX_PROVIDER=microsandbox
SANDBOX_TIMEOUT_SECONDS=3900
RUN_WALL_CLOCK_SECONDS=3600
# Idle session workspaces are deleted after seven days. Conversation checkpoints remain.
SESSION_WORKSPACE_RETENTION_SECONDS=604800

E2B_API_KEY=
E2B_TEMPLATE=pi-cloud-agent

# microSandbox consumes an OCI image. Build it with `pnpm sandbox:image`, or
# point this at an image available to the local microSandbox runtime.
MICROSANDBOX_IMAGE=pi-cloud-agent:local
MICROSANDBOX_CPUS=4
MICROSANDBOX_MEMORY_MB=4096
# Host access is needed for the local controller callback. Disable it when the
# controller is reachable through a public/internal URL instead.
MICROSANDBOX_ALLOW_HOST=true

# ── VCS connections ─────────────────────────────────────────────────────────
# Session and VCS tokens are encrypted/hashed in Postgres; generate both values with `openssl rand -hex 32`.
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
VCS_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# Use a distinct 64-character hexadecimal key for model credentials.
LLM_ENCRYPTION_KEY=replace-with-a-distinct-64-hex-character-key

# GitHub App user authorization. Callback: /auth/github/callback
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_REDIRECT_URI=http://localhost:8080/auth/github/callback

# Azure DevOps uses Microsoft Entra ID OAuth. Callback: /vcs/connections/azure-devops/callback
AZURE_DEVOPS_CLIENT_ID=
AZURE_DEVOPS_CLIENT_SECRET=
AZURE_DEVOPS_TENANT_ID=
AZURE_DEVOPS_REDIRECT_URI=http://localhost:8080/vcs/connections/azure-devops/callback

# ── web dashboard ────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
WEB_CORS_ORIGINS=http://localhost:3000
# Authentication is required for tasks and all user-scoped resources. Set false
# only for local read-only browsing of public metadata and repositories.
APP_AUTH_REQUIRED=true

# ── plugins / marketplace ───────────────────────────────────────────────────
# Comma-separated GitHub logins that may publish/review plugins and seed the catalog.
OPERATOR_GITHUB_LOGINS=
# Where published plugin packages are stored (defaults to .pi-plugin-artifacts).
PLUGIN_ARTIFACT_ROOT=
# In-repo marketplace plugins (single source of truth; defaults to marketplace/plugins).
PLUGIN_MARKETPLACE_ROOT=
# Binaries allowed for command-based MCP servers. Empty = URL/SSE only.
MCP_COMMAND_ALLOWLIST=
# Plugin MCP OAuth callback (defaults to CONTROL_PLANE_URL/plugins/oauth/callback).
PLUGIN_OAUTH_REDIRECT_URI=
# Authorization-server hostnames allowed for plugin OAuth (comma-separated).
PLUGIN_OAUTH_ISSUER_ALLOWLIST=auth.exa.ai
