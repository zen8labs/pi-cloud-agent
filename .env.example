# Copy to .env and fill in. Never commit .env.
# One file at the repo root configures the controller; the web app reads only NEXT_PUBLIC_API_BASE.

# ── controller ───────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info

# Postgres. `pnpm up` starts one on 5532.
DATABASE_URL=postgres://pi_cloud_agent:pi_cloud_agent@localhost:5532/pi_cloud_agent

# The URL the sandbox dials back on. Must be reachable *from the sandbox*, so for E2B this is the authenticated ngrok URL from DEVELOPMENT.md, not localhost.
CONTROL_PLANE_URL=https://your-development-domain.ngrok.app

# ── model ────────────────────────────────────────────────────────────────────
# provider/model. The provider segment names an OpenAI-compatible gateway.
AGENT_MODEL=aigateway/MiniMax/MiniMax-M2.7
AIGATEWAY_BASE_URL=
AIGATEWAY_API_KEY=

# ── sandbox ──────────────────────────────────────────────────────────────────
# Which SandboxProvider to use. See docs/adding-a-sandbox-provider.md.
SANDBOX_PROVIDER=e2b
SANDBOX_TIMEOUT_SECONDS=3900
RUN_WALL_CLOCK_SECONDS=3600
# Idle session workspaces are deleted after seven days. Conversation checkpoints remain.
SESSION_WORKSPACE_RETENTION_SECONDS=604800

E2B_API_KEY=
E2B_TEMPLATE=pi-cloud-agent

# ── VCS connections ─────────────────────────────────────────────────────────
# Session and VCS tokens are encrypted/hashed in Postgres; generate both values with `openssl rand -hex 32`.
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
VCS_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# GitHub App user authorization. Callback: /auth/github/callback
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_REDIRECT_URI=http://localhost:8080/auth/github/callback

# Azure DevOps uses Microsoft Entra ID OAuth. Callback: /vcs/connections/azure-devops/callback
AZURE_DEVOPS_CLIENT_ID=
AZURE_DEVOPS_CLIENT_SECRET=
AZURE_DEVOPS_TENANT_ID=
AZURE_DEVOPS_REDIRECT_URI=http://localhost:8080/vcs/connections/azure-devops/callback

# ── web dashboard ────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
WEB_CORS_ORIGINS=http://localhost:3000
APP_AUTH_REQUIRED=true
