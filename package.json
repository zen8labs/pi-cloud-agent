{
  "name": "pi-cloud-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A minimal and self-contained cloud agent built from first principles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zen8labs/pi-cloud-agent.git"
  },
  "homepage": "https://github.com/zen8labs/pi-cloud-agent#readme",
  "bugs": {
    "url": "https://github.com/zen8labs/pi-cloud-agent/issues"
  },
  "keywords": [
    "coding-agent",
    "cloud-agent",
    "background-agent",
    "ai-agent",
    "sandbox",
    "code-review",
    "pi"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "turbo dev",
    "controller": "pnpm --filter @pi-cloud-agent/controller dev",
    "web": "pnpm --filter @pi-cloud-agent/web dev",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "boundaries": "tsx scripts/check-boundaries.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:live": "vitest run --project live",
    "test:watch": "vitest",
    "db:migrate": "pnpm --filter @pi-cloud-agent/controller db:migrate",
    "sandbox:template": "pnpm --filter @pi-cloud-agent/runtime template:build",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "verify": "pnpm lint && pnpm boundaries && pnpm typecheck && pnpm test && pnpm test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
