# Reverse proxy for the controller on EC2.
#
# Copy this file to /etc/caddy/Caddyfile on the instance, then:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# This instance's security group allows TCP 80, not 443. Serve HTTP on :80.
# TLS for browsers is at Cloudflare on zen8agent.theprimitiveworks.com.
# The Worker fetches http://zen8agent-api.theprimitiveworks.com (grey cloud).

http://zen8agent-api.theprimitiveworks.com {
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}
}
