# Reverse proxy for the controller on EC2.
#
# Copy this file to /etc/caddy/Caddyfile on the instance, then:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# agent-api.zen8labs.io uses Caddy automatic HTTPS (Let's Encrypt).
# Keep the previous origin on HTTP so the old Cloudflare worker path still works.

agent-api.zen8labs.io {
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}
}

http://zen8agent-api.theprimitiveworks.com {
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}
}
