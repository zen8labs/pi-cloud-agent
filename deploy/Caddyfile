# Reverse proxy for the controller.
#
# Copy to /etc/caddy/Caddyfile, then:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Automatic HTTPS (Let's Encrypt) on :443. Port 80 stays open for ACME
# and HTTP→HTTPS. See docs/deployment.md.

agent-api.zen8labs.io {
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}
}
