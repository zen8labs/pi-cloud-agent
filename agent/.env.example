# ── Core service ────────────────────────────────────────────────────────────
AGENT_ENV=local
AGENT_HOST=0.0.0.0
AGENT_PORT=8080
# Public URL the sandbox bridge dials back to. For local dev use an ngrok/cloudflared
# tunnel (see README "How to test"). MUST be reachable from the sandbox.
CONTROL_PLANE_URL=http://localhost:8080

# ── State ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://coreview:coreview@localhost:5432/coreview_agent

# ── Sandbox (E2B) ───────────────────────────────────────────────────────────
E2B_API_KEY=
# Template built from Dockerfile.sandbox via `e2b template build` (see README).
E2B_TEMPLATE=coreview-agent
SANDBOX_TIMEOUT_SECONDS=3600
RUN_WALL_CLOCK_SECONDS=3600
# Comma-separated egress allowlist hosts for the sandbox (package mirrors, VCS host).
SANDBOX_EGRESS_ALLOWLIST=github.com,api.github.com,codeload.github.com,registry.npmjs.org,pypi.org,files.pythonhosted.org

# ── Harness / model routing (follows pr-agent: LiteLLM model identifiers) ─────
HARNESS=pi
# Self-hosted MiniMax over an OpenAI-compatible gateway (same as ../pr-agent).
# The model id + gateway are shared by the controller LLM service AND the
# in-sandbox OpenCode harness. The provider prefix ("openai") becomes the
# custom provider id injected into OpenCode via @ai-sdk/openai-compatible.
AGENT_MODEL=aigateway/MiniMax/MiniMax-M2.7
AGENT_FALLBACK_MODELS=
AI_TIMEOUT=120
LLM_MAX_TOKENS=32000

# OpenAI-compatible gateway for MiniMax. Point at your self-hosted endpoint.
AIGATEWAY_BASE_URL=
AIGATEWAY_API_KEY=
# Optional: other LLM providers.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# ── Rollout flag ──────────────────────────────────────────────────────────────
# Default routing when a repo has no explicit override: "legacy" | "agentic"
DEFAULT_REVIEW_MODE=agentic

# ── VCS: GitHub ─────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Webhook secret: Generate randomly and paste to github 
#   openssl rand -base64 32
GITHUB_WEBHOOK_SECRET=
# Fallback PAT for local testing without a GitHub App:
GITHUB_TOKEN=

# ── VCS: GitLab ──────────────────────────────────────────────────────────────
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
GITLAB_URL=https://gitlab.com

# ── VCS: Bitbucket ───────────────────────────────────────────────────────────
BITBUCKET_TOKEN=
BITBUCKET_WEBHOOK_SECRET=
