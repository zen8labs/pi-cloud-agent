// OpenCode config for the general_agent bundle (OpenCode 1.16.2).
//
// Mirrors the pr_review config but with full write access: this is a coding
// agent that may edit files, run commands, and iterate — not a read-only
// reviewer. The supervisor parses this file, overwrites `model`/`small_model`
// with the resolved AGENT_MODEL, and hands it to OpenCode via
// OPENCODE_CONFIG_CONTENT. There are no staged custom tools/subagents for this
// bundle, so this file only carries model selection, permissions, and tools.
{
  "$schema": "https://opencode.ai/config.json",

  // The supervisor authoritatively overwrites these with the resolved
  // AGENT_MODEL (provider/model) before launch; the value here is a fallback.
  "model": "{env:AGENT_MODEL}",
  "small_model": "{env:AGENT_MODEL}",

  // Headless: allow all built-in actions so the agent is never blocked on an
  // interactive permission prompt it cannot answer.
  "permission": { "*": { "*": "allow" } },

  // Full toolset — read context, search, run commands, and write/edit files.
  "tools": {
    "read": true,
    "grep": true,
    "glob": true,
    "bash": true,
    "edit": true,
    "write": true
  }
}
