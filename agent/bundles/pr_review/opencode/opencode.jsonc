// OpenCode config for the pr_review bundle (OpenCode 1.16.2).
//
// The in-sandbox supervisor parses this file, injects the concrete
// provider/model resolved from AGENT_MODEL, and hands the result to OpenCode
// inline via OPENCODE_CONFIG_CONTENT (the proven path the reference uses).
//
// Subagents are NOT declared here: matching the reference, the supervisor
// stages them into the workspace's `.opencode/` so OpenCode auto-discovers them —
//   * reviewer.md/critic.md -> .opencode/agent/   (subagent prompt bodies)
// so this file only carries model selection, permissions, and tool enablement.
// The agent posts its review with the `gh` CLI via the built-in bash tool;
// there is no plugin tool to declare.
{
  "$schema": "https://opencode.ai/config.json",

  // --- Model selection -----------------------------------------------------
  // {env:AGENT_MODEL} is a documented hint, but the supervisor authoritatively
  // overwrites `model`/`small_model` with the resolved AGENT_MODEL
  // (provider/model, e.g. "anthropic/claude-sonnet-4-6") before launch, so the
  // value here is just a sensible default if parsing is ever bypassed.
  "model": "{env:AGENT_MODEL}",
  "small_model": "{env:AGENT_MODEL}",

  // --- Permissions ---------------------------------------------------------
  // Headless review: allow all built-in actions so the agent is never blocked
  // on an interactive permission prompt it cannot answer.
  "permission": { "*": { "*": "allow" } },

  // --- Tools ---------------------------------------------------------------
  // Enable the built-in file/search/exec/edit tools the reviewer needs to pull
  // surrounding context, run linters/tests, and post the review via `gh` (bash).
  "tools": {
    "read": true,
    "grep": true,
    "glob": true,
    "bash": true,
    "edit": true
  }
}
