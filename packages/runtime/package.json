{
  "name": "@pi-cloud-agent/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs inside the sandbox: checkout, one Pi session, outbound reporting",
  "main": "./run.ts",
  "exports": {
    ".": "./run.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsx build.ts",
    "template:build": "pnpm build && pnpm --filter @pi-cloud-agent/sandbox template"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@pi-cloud-agent/protocol": "workspace:*",
    "pi-mcp-adapter": "2.31.0"
  },
  "devDependencies": {
    "@pi-cloud-agent/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "typescript": "catalog:"
  }
}
