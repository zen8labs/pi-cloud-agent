# App-owned runtime payload. The project image is never a build input here.
FROM node:22-bookworm-slim AS runtime
WORKDIR /opt/pi-cloud-agent
COPY dist/package.json dist/patch-pi-ai-exports.mjs ./
RUN npm install --omit=dev --no-audit --no-fund \
    && node patch-pi-ai-exports.mjs \
    && rm patch-pi-ai-exports.mjs
COPY dist/run.js ./run.js
RUN mkdir bin && cp /usr/local/bin/node bin/node
ARG TARGETARCH
RUN tar -czf /runtime-linux-${TARGETARCH}.tar.gz .

FROM scratch AS artifact
COPY --from=runtime /runtime-linux-*.tar.gz /
