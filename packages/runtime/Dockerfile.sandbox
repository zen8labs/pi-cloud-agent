# The sandbox image: a checkout, a shell, and one agent.
#
# No credential is baked in. The controller injects a scoped forge token and the
# model key per run, and they live only in that run's process environment.
#
# Build with: pnpm sandbox:image (or pnpm sandbox:template for E2B)
FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        bash \
    && rm -rf /var/lib/apt/lists/*

# The GitHub CLI is how a profile actuates its own outcomes — posting a review,
# opening a pull request — with the token it was given.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# dist/package.json pins Pi to the version the bundle was built against, and Pi
# ships a shrinkwrap, so this layer is reproducible.
COPY dist/package.json /app/package.json
COPY dist/patch-pi-ai-exports.mjs /app/patch-pi-ai-exports.mjs
RUN npm install --omit=dev --no-audit --no-fund \
    && node /app/patch-pi-ai-exports.mjs \
    && rm /app/patch-pi-ai-exports.mjs

COPY dist/run.js /app/run.js

# Where the repository is cloned and the agent works.
RUN mkdir -p /workspace/.pi-cloud-agent \
    && chmod 1777 /workspace \
    && chown node:node /workspace/.pi-cloud-agent \
    && chmod 700 /workspace/.pi-cloud-agent

# E2B runs a template's start command at build time, so the real per-run command
# is issued on create instead — it needs values that only exist then. See
# packages/sandbox/e2b.ts.
CMD ["node", "/app/run.js"]
