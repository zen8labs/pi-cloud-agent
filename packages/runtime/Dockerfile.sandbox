# The default project environment. The app runtime is installed by the provider.
#
# No credential is baked in. The controller injects a scoped forge token and the
# model key per run, and they live only in that run's process environment.
#
# Build with: pnpm sandbox:image (or pnpm sandbox:template for E2B)
FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    DEBIAN_FRONTEND=noninteractive \
    HOME=/home/pi-agent \
    VIRTUAL_ENV=/home/pi-agent/.venv

ENV PATH=/home/pi-agent/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        curl \
        file \
        git \
        git-lfs \
        jq \
        less \
        openssh-client \
        patch \
        pkg-config \
        procps \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python-is-python3 \
        ripgrep \
        unzip \
        xz-utils \
        zip \
    && pip3 install --break-system-packages --no-cache-dir uv==0.11.20 \
    && npm install --global --no-audit --no-fund pnpm@11.1.3 \
    && useradd --create-home --shell /bin/bash pi-agent \
    && python3 -m venv /home/pi-agent/.venv \
    && chown -R pi-agent:pi-agent /home/pi-agent \
    && git lfs install --system \
    && rm -rf /var/lib/apt/lists/*

# Keep large package downloads off microSandbox's separate 512 MiB /tmp tmpfs.
RUN mkdir -p /workspace/.tmp && chmod 1777 /workspace/.tmp

ENV TMPDIR=/workspace/.tmp

# The GitHub CLI is how the agent actuates outcomes — posting a review,
# opening a pull request — with the token it was given.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
USER pi-agent
CMD ["sleep", "infinity"]
